{
  "manifest_version": 3,
  "name": "크레이브사가 번역기",
  "version": "0.3.10",
  "description": "AI 게임 번역과 캐시 On/Off 리모콘, 현재 화면 번역 즉시 수정을 지원합니다.",
  "minimum_chrome_version": "116",
  "permissions": [
    "storage",
    "offscreen"
  ],
  "host_permissions": [
    "https://gg-client-r.crave-saga.net/*"
  ],
  "optional_permissions": [
    "nativeMessaging"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "background": {
    "service_worker": "background.mjs",
    "type": "module"
  },
  "action": {
    "default_title": "크레이브사가 번역기",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://gg-client-r.crave-saga.net/client/*/index_dmm.html"
      ],
      "js": [
        "dialogue-text.js",
        "name-policy.js",
        "story-policy.js",
        "main.js"
      ],
      "all_frames": true,
      "world": "MAIN",
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://gg-client-r.crave-saga.net/client/*/index_dmm.html"
      ],
      "js": [
        "retry-policy.js",
        "auto-advance.js",
        "distribution-client.js",
        "game-remote.js",
        "content.js"
      ],
      "all_frames": true,
      "world": "ISOLATED",
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["dialogue-text.js"],
      "matches": ["https://gg-client-r.crave-saga.net/*"]
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; worker-src 'self'; object-src 'none'; base-uri 'none'"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
